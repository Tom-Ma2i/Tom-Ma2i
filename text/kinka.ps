/lw-v exch def
/lw-h exch def
/savecurfont currentfont def
findfont dup setfont
[
( ) stringwidth pop dup lw-h exch div
exch lw-v exch div 0 0 3 -1 roll
0 0
] makefont def
savecurfont setfont
} bind def
/LWJF /LWF load def
