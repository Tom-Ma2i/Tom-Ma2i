closepath clip
} if
} bind def
/@beginspecial {
/SpecialSave save def
currentpoint transform initgraphics itransform translate
@SpecialDefaults
@MacSetUp
} bind def
/@setspecial {
hof vof translate
EPSF BBOX and {
hsi 0 eq {
vsi 0 eq {
hsc vsc
}{
vsi ury lly sub div dup
}ifelse
}{
vsi 0 eq {
