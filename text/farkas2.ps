/lw-v exch def
/lw-h exch def
/savecurfont currentfont def
findfont dup setfont
[
( ) stringwidth pop dup lw-h exch div
exch lw-v exch div 0 0 3 -1 roll
0 0
] makefont def
savecurfont setfont
} bind def
/LWJF /LWF load def
/SF /setfont load def
/s3 3 string def
/D {
/ch-code exch def
dup 0 get
length 2 lt {
pop [ <00> 1 1 0 0 8.00 ]
} if
/ch-data exch def
currentfont /BitMaps get ch-code ch-data put
currentfont /Encoding get ch-code
dup s3 cvs cvn
put
} bind def
